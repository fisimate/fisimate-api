DATABASE_URL=
# Optional: only needed when DATABASE_URL points to a connection pooler in
# transaction mode (e.g. Supabase's pooler on port 6543, `?pgbouncer=true`).
# Prisma Migrate needs a direct/session connection for DDL, so point this at
# the non-pooled connection string (e.g. Supabase's session pooler on port
# 5432, or the same value as DATABASE_URL for plain Postgres setups).
DIRECT_URL=
APP_URL=

JWT_SECRET=
JWT_EXP=

JWT_REFRESH_EXP=
JWT_REFRESH_SECRET=

SMTP_USERNAME=
SMTP_PASSWORD=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CLIENT_REDIRECT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT=

CERT_LOCATION=

GEMINI_API_KEY=

SUPABASE_PROJECT_URL=
SUPABASE_API_KEY=
# Optional, default: fisimate-bucket. Bucket must be created as a public bucket in Supabase.
SUPABASE_BUCKET_NAME=